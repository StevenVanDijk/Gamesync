{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/gamesync/browser",
  "rewrites": [
    { "source": "/api/steam/(.*)", "destination": "/api/steam" },
    { "source": "/api/gog/(.*)", "destination": "/api/gog" },
    { "source": "/api/blob/(.*)", "destination": "/api/blob" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
